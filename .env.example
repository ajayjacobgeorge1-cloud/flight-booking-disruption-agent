# Copy to .env. No API key needed -- this project authenticates via the
# Claude Code CLI's own login (run `claude` once and log in interactively,
# or `claude setup-token` for a long-lived token).

# Only needed if `claude` is not on PATH: absolute path to the CLI binary.
# CLAUDE_CODE_CLI_PATH=/path/to/claude

# Model alias or full model ID for the coordinator and its subagents.
# Leave unset to use the CLI's own default model.
# CLAUDE_MODEL=claude-sonnet-5

# Business rule: rebook actions with a fare difference at/above this amount
# (USD) are denied by the PreToolUse hook and routed to human escalation.
REBOOKING_AUTONOMY_THRESHOLD_USD=750
